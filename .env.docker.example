# ── Self-hosted Docker template (tracked) ─────────────────────────────────────
# Purpose: run the published container image with docker compose (Caddy + SQLite).
# Loaded by: `env_file: .env` in docker-compose.yml, so copy this file to `.env`
# next to the compose file. The container reads the same names from its process
# environment; the Go Docker entrypoint also reads LITESTREAM_* for replication.
#
# Tracked by git — every value here must stay a placeholder. Local values belong
# in the gitignored root `.env`, not this file. See docs/environment-files.md.

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
BASE_URL=https://comments.example.com
# Trust client IP headers only while the app is behind the supplied Caddy proxy.
# Set false if you expose the app directly.
TRUST_PROXY=true
# Optional logging overrides (defaults shown).
# LOG_LEVEL=info
# LOG_FORMAT=text

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated publisher origins that may embed the comment widget.
# BASE_URL is accepted separately for dashboard browser requests.
ALLOWED_ORIGINS=https://publisher.example.com

# ── Litestream replication (optional — strongly recommended) ──────────────────
# Replica URL for Litestream v0.3.14; custom endpoints may need extra configuration.
# Leave blank to run without replication.
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── OAuth providers ───────────────────────────────────────────────────────────
# Configure a complete OAuth provider, or enable email auth with SMTP.
# Redirect URI to register: <BASE_URL>/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / password auth (disabled by default) ───────────────────────────────
EMAIL_AUTH_ENABLED=false

# SMTP — used for verification emails, password reset, and comment notifications.
# Any STARTTLS submission endpoint on port 587 works. Self-hosted builds send
# every message over SMTP by default; the Cloudflare email API is a cloud feature.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_COMMENTS=5/10m
RATE_LIMIT_AUTH=10/5m

# ── Spam filtering ────────────────────────────────────────────────────────────
SPAM_MAX_LINKS=3

# ── Bot protection (optional) ─────────────────────────────────────────────────
# Cloudflare Turnstile — omit both to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Notifications ─────────────────────────────────────────────────────────────
NOTIFY_BATCH_SIZE=5
# Fallback recipient if the site owner has no email on file.
NOTIFY_EMAIL_TO=

# ── Notification email API (cloud builds only) ────────────────────────────────
# Self-hosted Docker images deliver notification digests over SMTP only. Cloud
# builds can send digests through the Cloudflare Email Sending REST API by
# setting EMAIL_PROVIDER=cloudflare plus the account credentials below. Left
# empty here to keep the SMTP default.
EMAIL_PROVIDER=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EMAIL_REPLY_TO=

# ── Database ───────────────────────────────────────────────────────────────────
# Self-hosted Docker runs SQLite only. Remote libSQL/Turso DATABASE_URL values
# are rejected before any database driver is opened.
DATABASE_URL=/data/db.sqlite
