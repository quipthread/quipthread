# ── Local development template (self-hosted, no cloud) ────────────────────────
# Minimal profile for running the Go backend from source with the default
# (non-cloud) build: `cd backend && go run .`.
#
# Copy this to the repository-root .env *before* changing into backend/:
#     cp .env.development.example .env   # run from the repository root
#     cd backend && go run .
#
# config.Load() reads ../.env (the repository root) first, then .env, without
# overwriting already-set values. A root .env therefore wins over backend/.env,
# so keep the active file at the root to avoid a stale one shadowing it.
#
# The managed cloud template is .env.cloud.example. It sets CLOUD_MODE=true and
# needs a cloud build (`-tags cloud`), APPROVAL_TOKEN_HMAC_KEY, and Turso
# credentials; do not point the default `go run .` at it - startup fails closed.

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
BASE_URL=http://localhost:8080
CLOUD_MODE=false
TRUST_PROXY=false
# Comma-separated publisher origins allowed to embed the widget. The Astro dev
# dashboard runs on :4321.
ALLOWED_ORIGINS=http://localhost:4321
# Proxy /dashboard/* to the Astro dev server so HMR works.
DEV_DASHBOARD_URL=http://localhost:4321

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite file. Self-hosted mode rejects remote libsql://, http://, https://.
DATABASE_URL=./data/comments.db

# ── Auth (configure one provider, or enable email auth) ───────────────────────
# GitHub OAuth: register http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth: add http://localhost:8080/auth/google/callback as a redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email + password auth (off by default). Required when no OAuth provider is set.
EMAIL_AUTH_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Optional ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=debug
# LOG_FORMAT=text
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
